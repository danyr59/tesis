# =============================================================================
# PLANTILLA DE CONFIGURACIÓN (.env): DESTILACIÓN MAESTRO-ESTUDIANTE
# =============================================================================
# Copia este archivo a '.env' y configura tu HF_TOKEN antes de ejecutar:
#   cp .env.example .env
# =============================================================================

# ── 1. Autenticación y APIs Externas ──────────────────────────────────────────
HF_TOKEN=tu_token_huggingface_aqui
GITHUB_TOKEN=

# ── 2. Identificadores de Modelos Base (Hugging Face) ─────────────────────────
# Modelos sugeridos para el Maestro:
#   • Qwen/Qwen2.5-7B-Instruct (Recomendado para E1, E4, E7)
#   • meta-llama/Llama-3.1-8B-Instruct (Para E2, E5, E8)
#   • google/gemma-2-9b-it (Para E3, E6, E9)
TEACHER_MODEL_ID=Qwen/Qwen2.5-7B-Instruct

# Modelos sugeridos para el Estudiante:
#   • Qwen/Qwen2.5-1.5B-Instruct (Línea base E1)
#   • meta-llama/Llama-3.2-1B-Instruct
#   • google/gemma-2-2b-it
STUDENT_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct

# ── 3. Rutas de Modelos y Adaptadores LoRA ────────────────────────────────────
# Si los directorios locales contienen checkpoints se usarán; si no, se resolverán vía HF.
TEACHER_MODEL_PATH=./models/profesor
STUDENT_MODEL_PATH=./models/student
TEACHER_MODEL_PATH_ADAPTERS=./models/teacher_adapters/qwen
STUDENT_LORA_PATH=./models/student_lora

# ── 4. Base Vectorial RAG (ChromaDB) ──────────────────────────────────────────
RAG_DB_PATH=./rag/maestro
RAG_TOP_K=50

# ── 5. Parámetros de Generación Sintética (Marco de Tesis) ────────────────────
# Total de puntos generados por lote = SYNTHETIC_NUM_SERIES * SYNTHETIC_POINTS_PER_SERIES
# Por defecto: 20 series x 400 puntos = 8.000 filas de series sintéticas
SYNTHETIC_NUM_SERIES=20
SYNTHETIC_POINTS_PER_SERIES=400
SYNTHETIC_CHUNK_SERIES=2
SYNTHETIC_CHUNK_POINTS=80
LLM_MAX_NEW_TOKENS=2048

# ── 6. Hiperparámetros de LoRA para Destilación Ligera (Estudiante) ───────────
LORA_R=8
LORA_ALPHA=16
LORA_DROPOUT=0.05

# ── 7. Optimización de Memoria y Hardware ─────────────────────────────────────
# Habilita cuantización 4-bit (BitsAndBytes NF4) en GPUs compatibles para no superar 7.2 GB VRAM
USE_4BIT=true
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
