# ── Modelos Hugging Face (Maestro y Estudiante - Línea Base E1) ──
TEACHER_MODEL_ID=Qwen/Qwen2.5-7B-Instruct
STUDENT_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
HF_TOKEN=tu_token_aqui

# ── Rutas Locales de Modelos y Adaptadores ──
TEACHER_MODEL_PATH=./models/profesor
STUDENT_MODEL_PATH=./models/student
STUDENT_LORA_PATH=./models/student_lora
TEACHER_ADAPTERS_PATH=./models/teacher_adapters

# ── Base Vectorial (RAG) ──
CHROMA_DB_PATH=./rag/maestro
COLLECTION_NAME=time_series_generation
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2

# ── Parámetros de Generación Sintética ──
SYNTHETIC_NUM_SERIES=20
SYNTHETIC_POINTS_PER_SERIES=400
SYNTHETIC_CHUNK_SERIES=2
SYNTHETIC_CHUNK_POINTS=80
LLM_MAX_NEW_TOKENS=2048
